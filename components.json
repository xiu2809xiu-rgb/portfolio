{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "radix-nova",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/app/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@reactbits-starter": {
      "url": "https://proxy.collectui.pro/api/r/reactbits/starter/{name}.json",
      "headers": {
        "Authorization": "Bearer ${REACTBITS_LICENSE_KEY}"
      }
    },
    "@reactbits-pro": {
      "url": "https://proxy.collectui.pro/api/r/reactbits/pro/{name}.json",
      "headers": {
        "Authorization": "Bearer ${REACTBITS_LICENSE_KEY}"
      }
    },
    "@motion": {
      "url": "https://proxy.collectui.pro/api/r/motion/{name}.json",
      "headers": {
        "Authorization": "Bearer ${MOTION_TOKEN}"
      }
    },
    "@reui": {
      "url": "https://proxy.collectui.pro/api/r/reui/{style}/{name}.json",
      "headers": {
        "Authorization": "Bearer ${REUI_LICENSE_KEY}"
      }
    },
    "@magicui-pro": {
      "url": "https://proxy.collectui.pro/api/r/magicui/{name}",
      "headers": {
        "Authorization": "Bearer ${MAGICUI_PRO_REGISTRY_TOKEN}"
      }
    },
    "@efferd": {
      "url": "https://proxy.collectui.pro/api/r/efferd/{style}/{name}.json",
      "headers": {
        "Authorization": "Bearer ${EFFERD_REGISTRY_TOKEN}"
      }
    },
    "@shadcn-space": {
      "url": "https://proxy.collectui.pro/api/r/shadcn-space/{name}.json",
      "params": {
        "email": "${SPACE_EMAIL}",
        "license_key": "${SPACE_LICENSE_KEY}"
      }
    },
    "@shadcn-studio": "https://proxy.collectui.pro/api/r/shadcnstudio/{style}/{name}.json",
    "@magicui": "https://magicui.design/r/{name}"
  }
}
