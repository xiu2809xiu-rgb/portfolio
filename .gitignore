# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets stay local, the documented template is committed
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local environment
.env.local
.env*.local

# Raw source assets (the optimised avatar.glb is committed instead)
public/models/avatar-raw.glb

# Scratch
scripts/_probe.mjs

# Agent scaffolding regenerated by tooling — not part of the project
AGENTS.md
CLAUDE.md
.claude/
