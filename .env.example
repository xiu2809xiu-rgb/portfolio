# ═══════════════════════════════════════════════════════════════════════════
#  Every value here is OPTIONAL.
#
#  The site runs and deploys with none of them set — the booking flow falls
#  back to demo availability and an in-memory store. Each variable you add
#  upgrades one slice in place. Check /api/health to see what resolved.
# ═══════════════════════════════════════════════════════════════════════════

# ── Site ──────────────────────────────────────────────────────────────────
# Canonical URL, used for metadata, OG tags, and the sitemap.
# Vercel fills this in automatically if you leave it unset.
NEXT_PUBLIC_SITE_URL=https://richiekoh.dev

# ── Google Calendar ───────────────────────────────────────────────────────
# Turns on real free/busy reads and real calendar invites.
# Get the client ID/secret from console.cloud.google.com (OAuth client ID →
# Web application, redirect URI http://localhost:5813/oauth2callback), then
# run: node scripts/google-auth.mjs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Attach a Google Meet link to each booking. Set to "false" to disable.
GOOGLE_CREATE_MEET_LINK=true

# ── Database (Neon / any Postgres) ────────────────────────────────────────
# Persists bookings across deploys. Without it they live in process memory
# and disappear on the next cold start.
DATABASE_URL=

# ── Email (Resend, optional) ──────────────────────────────────────────────
# Google already sends the calendar invite; this adds a branded confirmation.
RESEND_API_KEY=
RESEND_FROM=Richie Koh <bookings@yourdomain.com>
BOOKING_OWNER_EMAIL=your@email.com

# ── Scheduling rules (all optional, sensible defaults shown) ──────────────
BOOKING_TIMEZONE=Asia/Singapore
# Mon=1 … Sun=7
BOOKING_WORKING_DAYS=1,2,3,4,5
# Comma-separated local windows
BOOKING_HOURS=09:00-12:30,14:00-18:30
BOOKING_SLOT_INTERVAL=30
BOOKING_MIN_NOTICE_MINUTES=120
BOOKING_HORIZON_DAYS=60
# Gap enforced either side of an existing commitment
BOOKING_BUFFER_MINUTES=0
BOOKING_MAX_PER_DAY=4

# ── Component registries (build-time only, for `npx shadcn add`) ──────────
REACTBITS_LICENSE_KEY=
MOTION_TOKEN=
REUI_LICENSE_KEY=
MAGICUI_PRO_REGISTRY_TOKEN=
EFFERD_REGISTRY_TOKEN=
SPACE_EMAIL=
SPACE_LICENSE_KEY=
